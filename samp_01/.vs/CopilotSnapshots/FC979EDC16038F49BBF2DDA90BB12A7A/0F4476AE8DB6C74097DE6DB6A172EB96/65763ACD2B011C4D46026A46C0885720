using System;
using System.Collections.Generic;
using System.Drawing;
using System.IO;
using System.Windows.Forms;
using samp_01.Domain.DTO;
using samp_01.Data.Repositories;
using samp_01.Services.ServiceProvider;

namespace samp_01.Forms.User
{
    public class UserServicesForm : Form
    {
        private readonly UserProfileDTO _user;
        private readonly IServiceRepository _serviceRepo = new AdoServiceRepository(AppConfig.ConnectionString);
        private readonly ISellerRepository _sellerRepo = new AdoSellerRepository(AppConfig.ConnectionString);
        private readonly PortfolioService _portfolioService = new PortfolioService();
        private readonly Stack<Action> _nav = new Stack<Action>();
        private Panel _host = null!;

        public UserServicesForm(UserProfileDTO user)
        {
            _user = user;
            Text = "Services";
            ClientSize = new Size(1000, 700);
            StartPosition = FormStartPosition.CenterScreen;
            BackColor = Color.FromArgb(248, 249, 250);
            Font = new Font("Segoe UI", 9);

            _host = new Panel { Dock = DockStyle.Fill, BackColor = BackColor, AutoScroll = true };
            Controls.Add(_host);

            ShowServices();
        }

        private static Image? LoadThumbnail(string path, int w, int h)
        {
            try
            {
                using var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read);
                using var img = Image.FromStream(fs, false, false);
                var bmp = new Bitmap(w, h);
                using var g = Graphics.FromImage(bmp);
                g.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.HighQualityBicubic;
                g.DrawImage(img, new Rectangle(0, 0, w, h));
                return bmp;
            }
            catch { return null; }
        }

        private Button CreateBackButton()
        {
            var btn = new Button
            {
                Text = "← Back",
                Left = 20,
                Top = 20,
                Width = 100,
                Height = 32,
                BackColor = Color.Transparent,
                FlatStyle = FlatStyle.Flat,
                Font = new Font("Segoe UI", 9)
            };
            btn.FlatAppearance.BorderColor = Color.FromArgb(200, 200, 200);
            btn.FlatAppearance.BorderSize = 1;
            btn.Click += (s, e) => { if (_nav.Count > 0) { var a = _nav.Pop(); a(); } };
            return btn;
        }

        private void LoadView(Control view)
        {
            _host.Controls.Clear();
            _host.Controls.Add(view);
        }

        private void ShowServices()
        {
            var panel = new Panel { Dock = DockStyle.Fill, BackColor = _host.BackColor, AutoScroll = true, Padding = new Padding(20) };

            var title = new Label
            {
                Text = "Available Services",
                Left = 0,
                Top = 0,
                AutoSize = true,
                Font = new Font("Segoe UI", 18, FontStyle.Bold),
                ForeColor = Color.FromArgb(45, 45, 48)
            };
            panel.Controls.Add(title);

            var flow = new FlowLayoutPanel
            {
                Left = 0,
                Top = 50,
                Width = panel.Width - 40,
                Height = panel.Height - 70,
                AutoScroll = true,
                WrapContents = true,
                FlowDirection = FlowDirection.LeftToRight,
                BackColor = Color.Transparent
            };

            foreach (var svc in _serviceRepo.GetAll())
            {
                var card = new Panel
                {
                    Width = 280,
                    Height = 120,
                    BackColor = Color.White,
                    BorderStyle = BorderStyle.FixedSingle,
                    Margin = new Padding(10),
                    Padding = new Padding(15)
                };

                var name = new Label
                {
                    Text = svc.Name,
                    Left = 0,
                    Top = 0,
                    Width = 250,
                    Font = new Font("Segoe UI", 12, FontStyle.Bold),
                    ForeColor = Color.FromArgb(45, 45, 48)
                };

                var btn = new Button
                {
                    Text = "View Providers",
                    Left = 0,
                    Top = 70,
                    Width = 120,
                    Height = 32,
                    BackColor = Color.FromArgb(10, 132, 255),
                    ForeColor = Color.White,
                    FlatStyle = FlatStyle.Flat,
                    Font = new Font("Segoe UI", 9)
                };
                btn.FlatAppearance.BorderSize = 0;
                btn.Click += (s, e) => { _nav.Push(ShowServices); ShowServiceSellers(svc.Id, svc.Name); };

                card.Controls.Add(name);
                card.Controls.Add(btn);
                flow.Controls.Add(card);
            }

            panel.Controls.Add(flow);
            LoadView(panel);
        }

        private void ShowServiceSellers(int serviceId, string serviceName)
        {
            var panel = new Panel { Dock = DockStyle.Fill, BackColor = _host.BackColor, AutoScroll = true, Padding = new Padding(20) };

            var back = CreateBackButton();
            panel.Controls.Add(back);

            var title = new Label
            {
                Text = serviceName + " - Service Providers",
                Left = 140,
                Top = 20,
                AutoSize = true,
                Font = new Font("Segoe UI", 18, FontStyle.Bold),
                ForeColor = Color.FromArgb(45, 45, 48)
            };
            panel.Controls.Add(title);

            var flow = new FlowLayoutPanel
            {
                Left = 0,
                Top = 70,
                Width = panel.Width - 40,
                Height = panel.Height - 90,
                AutoScroll = true,
                WrapContents = true,
                FlowDirection = FlowDirection.LeftToRight,
                BackColor = Color.Transparent
            };

            var sellers = _sellerRepo.GetSellersByService(serviceId);
            foreach (var s in sellers)
            {
                var card = new Panel
                {
                    Width = 320,
                    Height = 200,
                    BackColor = Color.White,
                    BorderStyle = BorderStyle.FixedSingle,
                    Margin = new Padding(10),
                    Padding = new Padding(15)
                };

                string? imgPath = !string.IsNullOrEmpty(s.LogoPath) && File.Exists(s.LogoPath) ? s.LogoPath : (!string.IsNullOrEmpty(s.PortfolioPicPath) && File.Exists(s.PortfolioPicPath) ? s.PortfolioPicPath : null);

                if (!string.IsNullOrEmpty(imgPath))
                {
                    var thumb = LoadThumbnail(imgPath, 80, 80);
                    if (thumb != null)
                    {
                        var pic = new PictureBox
                        {
                            Left = 220,
                            Top = 15,
                            Width = 80,
                            Height = 80,
                            SizeMode = PictureBoxSizeMode.Zoom,
                            Image = thumb,
                            BorderStyle = BorderStyle.FixedSingle
                        };
                        card.Controls.Add(pic);
                    }
                }

                var name = new Label
                {
                    Text = s.CompanyName,
                    Left = 0,
                    Top = 0,
                    Width = 200,
                    Font = new Font("Segoe UI", 12, FontStyle.Bold),
                    ForeColor = Color.FromArgb(45, 45, 48)
                };

                var desc = new Label
                {
                    Text = s.ShortDescription ?? "No description available",
                    Left = 0,
                    Top = 30,
                    Width = 200,
                    Height = 60,
                    ForeColor = Color.FromArgb(100, 100, 100)
                };

                var btn = new Button
                {
                    Text = "View Portfolio",
                    Left = 0,
                    Top = 150,
                    Width = 120,
                    Height = 32,
                    BackColor = Color.FromArgb(10, 132, 255),
                    ForeColor = Color.White,
                    FlatStyle = FlatStyle.Flat,
                    Font = new Font("Segoe UI", 9)
                };
                btn.FlatAppearance.BorderSize = 0;
                btn.Click += (sender, e) => { _nav.Push(() => ShowServiceSellers(serviceId, serviceName)); ShowSellerPortfolio(s.Id, s.CompanyName); };

                card.Controls.Add(name);
                card.Controls.Add(desc);
                card.Controls.Add(btn);
                flow.Controls.Add(card);
            }

            panel.Controls.Add(flow);
            LoadView(panel);
        }

        private void ShowSellerPortfolio(int sellerId, string companyName)
        {
            var panel = new Panel { Dock = DockStyle.Fill, BackColor = _host.BackColor, AutoScroll = true, Padding = new Padding(20) };

            var back = CreateBackButton();
            panel.Controls.Add(back);

            var title = new Label
            {
                Text = companyName + " - Portfolio",
                Left = 140,
                Top = 20,
                AutoSize = true,
                Font = new Font("Segoe UI", 18, FontStyle.Bold),
                ForeColor = Color.FromArgb(45, 45, 48)
            };
            panel.Controls.Add(title);

            var y = 70;
            var portfolio = _portfolioService.Get(sellerId);
            var seller = _sellerRepo.GetSellerEntityById(sellerId);

            // Portfolio Details Card
            var details = new Panel
            {
                Left = 0,
                Top = y,
                Width = panel.Width - 40,
                Height = 320,
                BackColor = Color.White,
                BorderStyle = BorderStyle.FixedSingle,
                Padding = new Padding(20),
                Anchor = AnchorStyles.Top | AnchorStyles.Left | AnchorStyles.Right
            };

            int left = 0;
            var hdrDesc = new Label
            {
                Text = "Description",
                Left = left,
                Top = 0,
                AutoSize = true,
                Font = new Font("Segoe UI", 10, FontStyle.Bold),
                ForeColor = Color.FromArgb(45, 45, 48)
            };
            var lblDesc = new Label
            {
                Text = portfolio?.Description ?? "No description available",
                Left = left,
                Top = 25,
                Width = 500,
                Height = 60,
                ForeColor = Color.FromArgb(80, 80, 80)
            };

            var hdrSkills = new Label
            {
                Text = "Skills & Expertise",
                Left = left,
                Top = 100,
                AutoSize = true,
                Font = new Font("Segoe UI", 10, FontStyle.Bold),
                ForeColor = Color.FromArgb(45, 45, 48)
            };
            var lblSkills = new Label
            {
                Text = portfolio?.Skills ?? "No skills listed",
                Left = left,
                Top = 125,
                Width = 500,
                Height = 40,
                ForeColor = Color.FromArgb(80, 80, 80)
            };

            var hdrPrice = new Label
            {
                Text = "Price Range",
                Left = left,
                Top = 180,
                AutoSize = true,
                Font = new Font("Segoe UI", 10, FontStyle.Bold),
                ForeColor = Color.FromArgb(45, 45, 48)
            };
            string priceText = "Not specified";
            if (portfolio != null && (portfolio.PriceRangeMin.HasValue || portfolio.PriceRangeMax.HasValue))
            {
                var min = portfolio.PriceRangeMin?.ToString("0.##") ?? "-";
                var max = portfolio.PriceRangeMax?.ToString("0.##") ?? "-";
                priceText = $"{min} - {max}";
            }
            var lblPrice = new Label
            {
                Text = priceText,
                Left = left + 100,
                Top = 180,
                AutoSize = true,
                ForeColor = Color.FromArgb(80, 80, 80)
            };

            // Profile Picture Section
            var hdrPic = new Label
            {
                Text = "Profile Picture",
                Left = 550,
                Top = 0,
                AutoSize = true,
                Font = new Font("Segoe UI", 10, FontStyle.Bold),
                ForeColor = Color.FromArgb(45, 45, 48)
            };

            details.Controls.Add(hdrDesc);
            details.Controls.Add(lblDesc);
            details.Controls.Add(hdrSkills);
            details.Controls.Add(lblSkills);
            details.Controls.Add(hdrPrice);
            details.Controls.Add(lblPrice);
            details.Controls.Add(hdrPic);

            if (!string.IsNullOrEmpty(portfolio?.ProfilePicPath) && File.Exists(portfolio.ProfilePicPath))
            {
                var thumb = LoadThumbnail(portfolio.ProfilePicPath, 120, 120);
                if (thumb != null)
                {
                    var pic = new PictureBox
                    {
                        Left = 550,
                        Top = 25,
                        Width = 120,
                        Height = 120,
                        SizeMode = PictureBoxSizeMode.Zoom,
                        Image = thumb,
                        BorderStyle = BorderStyle.FixedSingle
                    };
                    details.Controls.Add(pic);
                }
            }

            // Seller Contact Information
            if (seller != null)
            {
                int sTop = 230;
                details.Controls.Add(new Label
                {
                    Text = "Company",
                    Left = left,
                    Top = sTop,
                    AutoSize = true,
                    Font = new Font("Segoe UI", 9, FontStyle.Bold),
                    ForeColor = Color.FromArgb(45, 45, 48)
                });
                details.Controls.Add(new Label
                {
                    Text = seller.CompanyName,
                    Left = left + 100,
                    Top = sTop,
                    AutoSize = true,
                    ForeColor = Color.FromArgb(80, 80, 80)
                });

                details.Controls.Add(new Label
                {
                    Text = "Email",
                    Left = 350,
                    Top = sTop,
                    AutoSize = true,
                    Font = new Font("Segoe UI", 9, FontStyle.Bold),
                    ForeColor = Color.FromArgb(45, 45, 48)
                });
                details.Controls.Add(new Label
                {
                    Text = seller.Email,
                    Left = 400,
                    Top = sTop,
                    AutoSize = true,
                    ForeColor = Color.FromArgb(80, 80, 80)
                });

                details.Controls.Add(new Label
                {
                    Text = "Phone",
                    Left = left,
                    Top = sTop + 25,
                    AutoSize = true,
                    Font = new Font("Segoe UI", 9, FontStyle.Bold),
                    ForeColor = Color.FromArgb(45, 45, 48)
                });
                details.Controls.Add(new Label
                {
                    Text = seller.Phone ?? "Not provided",
                    Left = left + 100,
                    Top = sTop + 25,
                    AutoSize = true,
                    ForeColor = Color.FromArgb(80, 80, 80)
                });

                details.Controls.Add(new Label
                {
                    Text = "Address",
                    Left = 350,
                    Top = sTop + 25,
                    AutoSize = true,
                    Font = new Font("Segoe UI", 9, FontStyle.Bold),
                    ForeColor = Color.FromArgb(45, 45, 48)
                });
                details.Controls.Add(new Label
                {
                    Text = seller.CompanyAddress ?? "Not provided",
                    Left = 410,
                    Top = sTop + 25,
                    AutoSize = true,
                    Width = 250,
                    ForeColor = Color.FromArgb(80, 80, 80)
                });
            }

            panel.Controls.Add(details);
            y += details.Height + 20;

            // Request Order Button
            var btnRequest = new Button
            {
                Text = "Request Service",
                Left = 0,
                Top = y,
                Width = 150,
                Height = 40,
                BackColor = Color.FromArgb(10, 132, 255),
                ForeColor = Color.White,
                FlatStyle = FlatStyle.Flat,
                Font = new Font("Segoe UI", 10, FontStyle.Bold)
            };
            btnRequest.FlatAppearance.BorderSize = 0;
            btnRequest.Click += (s, e) =>
            {
                // TODO: Create order request record linking _user.Id and sellerId
                MessageBox.Show($"Service request sent by '{_user.Name}' to '{companyName}'.", "Request Sent", MessageBoxButtons.OK, MessageBoxIcon.Information);
            };
            panel.Controls.Add(btnRequest);
            y += 60;

            // Past Projects Section
            var projectsTitle = new Label
            {
                Text = "Past Projects",
                Left = 0,
                Top = y,
                AutoSize = true,
                Font = new Font("Segoe UI", 16, FontStyle.Bold),
                ForeColor = Color.FromArgb(45, 45, 48)
            };
            panel.Controls.Add(projectsTitle);
            y += 40;

            var flow = new FlowLayoutPanel
            {
                Left = 0,
                Top = y,
                Width = panel.Width - 40,
                Height = panel.Height - y - 20,
                AutoScroll = true,
                WrapContents = true,
                FlowDirection = FlowDirection.LeftToRight,
                BackColor = Color.Transparent
            };

            foreach (var p in _portfolioService.ListProjects(sellerId))
            {
                var card = new Panel
                {
                    Width = 280,
                    Height = 180,
                    BackColor = Color.White,
                    BorderStyle = BorderStyle.FixedSingle,
                    Margin = new Padding(10),
                    Padding = new Padding(15)
                };

                var name = new Label
                {
                    Text = p.Title,
                    Left = 0,
                    Top = 0,
                    Width = 150,
                    Font = new Font("Segoe UI", 11, FontStyle.Bold),
                    ForeColor = Color.FromArgb(45, 45, 48)
                };

                var desc = new Label
                {
                    Text = p.Description ?? "No description available",
                    Left = 0,
                    Top = 25,
                    Width = 150,
                    Height = 70,
                    ForeColor = Color.FromArgb(80, 80, 80)
                };

                if (!string.IsNullOrEmpty(p.ImagePath) && File.Exists(p.ImagePath))
                {
                    var thumb = LoadThumbnail(p.ImagePath, 80, 80);
                    if (thumb != null)
                    {
                        var pic = new PictureBox
                        {
                            Left = 170,
                            Top = 10,
                            Width = 80,
                            Height = 80,
                            SizeMode = PictureBoxSizeMode.Zoom,
                            Image = thumb,
                            BorderStyle = BorderStyle.FixedSingle
                        };
                        card.Controls.Add(pic);
                    }
                }

                card.Controls.Add(name);
                card.Controls.Add(desc);
                flow.Controls.Add(card);
            }

            panel.Controls.Add(flow);
            LoadView(panel);
        }
    }
}