using System;
using System.Drawing;
using System.IO;
using System.Windows.Forms;
using samp_01.Services.ServiceProvider;
using samp_01.Domain.DTO;

namespace samp_01.Forms.ServiceProvider
{
 public class ProviderRegistrationForm : Form
 {
 private TextBox txtName, txtEmail, txtPass, txtPass2, txtPhone, txtCompany, txtAddress;
 private ComboBox cboService;
 private PictureBox picLogo;
 private Button btnPickLogo, btnRegister, btnCancel;
 private Label lblMessage;
 private readonly ServProRegistrationService _reg;

 public ProviderRegistrationForm()
 {
 _reg = new ServProRegistrationService();

 Text = "Register as Service Provider";
 ClientSize = new Size(560,480);
 StartPosition = FormStartPosition.CenterParent;
 Font = new Font("Segoe UI",9);

 int y =12;
 void AddLabelAnd(Control c, string label)
 {
 var l = new Label { Text = label, Left =12, Top = y +4, Width =120 };
 c.Left =140; c.Top = y; c.Width =360;
 Controls.Add(l); Controls.Add(c);
 y +=40;
 }

 txtName = new TextBox(); AddLabelAnd(txtName, "Seller Name");
 txtEmail = new TextBox(); AddLabelAnd(txtEmail, "Email");
 txtPass = new TextBox { UseSystemPasswordChar = true }; AddLabelAnd(txtPass, "Password");
 txtPass2 = new TextBox { UseSystemPasswordChar = true }; AddLabelAnd(txtPass2, "Confirm Password");
 txtPhone = new TextBox(); AddLabelAnd(txtPhone, "Phone");
 cboService = new ComboBox { DropDownStyle = ComboBoxStyle.DropDownList };
 cboService.Items.AddRange(new object[] { "3D modeling", "Photography" });
 AddLabelAnd(cboService, "Service Type");
 txtCompany = new TextBox(); AddLabelAnd(txtCompany, "Company Name");
 txtAddress = new TextBox(); AddLabelAnd(txtAddress, "Company Address");

 picLogo = new PictureBox { Left =140, Top = y, Width =120, Height =80, BorderStyle = BorderStyle.FixedSingle, SizeMode = PictureBoxSizeMode.Zoom };
 btnPickLogo = new Button { Text = "Pick Logo", Left =280, Top = y +20, Width =100 };
 btnPickLogo.Click += BtnPickLogo_Click;
 Controls.Add(picLogo); Controls.Add(btnPickLogo);
 y +=100;

 lblMessage = new Label { Left =12, Top = y +4, Width =480, ForeColor = Color.FromArgb(180,0,0) }; Controls.Add(lblMessage);

 btnRegister = new Button { Text = "Register", Left =140, Top = y +40, Width =120, BackColor = Color.FromArgb(10,132,255), ForeColor = Color.White };
 btnRegister.Click += BtnRegister_Click; Controls.Add(btnRegister);
 btnCancel = new Button { Text = "Cancel", Left =280, Top = y +40, Width =120 };
 btnCancel.Click += (s,e) => { DialogResult = DialogResult.Cancel; Close(); };
 Controls.Add(btnCancel);
 }

 private void BtnPickLogo_Click(object? sender, EventArgs e)
 {
 using var dlg = new OpenFileDialog { Filter = "Images|*.jpg;*.jpeg;*.png" };
 if (dlg.ShowDialog(this) == DialogResult.OK)
 {
 picLogo.Image = Image.FromFile(dlg.FileName);
 picLogo.Tag = dlg.FileName;
 }
 }

 private void BtnRegister_Click(object? sender, EventArgs e)
 {
 lblMessage.Text = "";
 if (txtPass.Text != txtPass2.Text) { lblMessage.Text = "Passwords do not match."; return; }
 if (cboService.SelectedItem == null) { lblMessage.Text = "Select a service."; return; }
 var svcName = cboService.SelectedItem.ToString();
 var serviceId = svcName == "3D modeling" ?1 :2; // assumes seeded ids
 var dto = new SellerRegisterDTO {
 Name = txtName.Text.Trim(),
 Email = txtEmail.Text.Trim(),
 Password = txtPass.Text,
 Phone = string.IsNullOrWhiteSpace(txtPhone.Text) ? null : txtPhone.Text.Trim(),
 ServiceId = serviceId,
 CompanyName = txtCompany.Text.Trim(),
 CompanyAddress = string.IsNullOrWhiteSpace(txtAddress.Text) ? null : txtAddress.Text.Trim(),
 LogoPath = null
 };

 if (picLogo.Tag != null)
 {
 var src = picLogo.Tag.ToString();
 var destDir = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "data","logos");
 Directory.CreateDirectory(destDir);
 var dest = Path.Combine(destDir, Path.GetFileName(src));
 File.Copy(src, dest, true);
 dto.LogoPath = dest;
 }

 if (_reg.Register(dto, out var error))
 {
 MessageBox.Show("Service provider registered.", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
 DialogResult = DialogResult.OK; Close();
 }
 else
 {
 lblMessage.Text = error ?? "Failed";
 }
 }
 }
}
