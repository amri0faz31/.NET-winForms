        private void ShowProfile()
        {
            // Embed UserProfileForm into the main panel
            var prof = new UserProfileForm(_profile.Name)
            {
                TopLevel = false,
                FormBorderStyle = FormBorderStyle.None,
                Dock = DockStyle.Fill
            };
            LoadView(prof);
            prof.Show();
        }

        // Services list as cards
        private void ShowServices()
        {
            var panel = new Panel { Dock = DockStyle.Fill, BackColor = _pnlMain.BackColor };
            var back = CreateBackButton(); panel.Controls.Add(back);
            var title = new Label { Text = "Services", Left = 120, Top = 14, AutoSize = true, Font = new Font("Segoe UI", 12, FontStyle.Bold) };
            panel.Controls.Add(title);
            var flow = new FlowLayoutPanel { Left = 20, Top = 50, Width = _pnlMain.Width - 40, Height = _pnlMain.Height - 70, AutoScroll = true, WrapContents = true, FlowDirection = FlowDirection.LeftToRight };
            foreach (var svc in _serviceRepo.GetAll())
            {
                var card = new Panel { Width = 220, Height = 110, BackColor = Color.White, BorderStyle = BorderStyle.FixedSingle, Margin = new Padding(8) };
                var name = new Label { Text = svc.Name, Left = 10, Top = 10, Width = 200, Font = new Font("Segoe UI", 10, FontStyle.Bold) };
                var btn = new Button { Text = "View", Left = 10, Top = 70, Width = 80 };
                btn.Click += (s, e) => { _nav.Push(ShowServices); ShowServiceSellers(svc.Id, svc.Name); };
                card.Controls.Add(name); card.Controls.Add(btn);
                flow.Controls.Add(card);
            }
            panel.Controls.Add(flow);
            LoadView(panel);
        }

        // Sellers for a service
        private void ShowServiceSellers(int serviceId, string serviceName)
        {
            var panel = new Panel { Dock = DockStyle.Fill, BackColor = _pnlMain.BackColor };
            var back = CreateBackButton(); panel.Controls.Add(back);
            var title = new Label { Text = serviceName + " - Sellers", Left = 120, Top = 14, AutoSize = true, Font = new Font("Segoe UI", 12, FontStyle.Bold) };
            panel.Controls.Add(title);
            var flow = new FlowLayoutPanel { Left = 20, Top = 50, Width = _pnlMain.Width - 40, Height = _pnlMain.Height - 70, AutoScroll = true, WrapContents = true, FlowDirection = FlowDirection.LeftToRight };
            var sellers = _sellerRepo.GetSellersByService(serviceId);
            foreach (var s in sellers)
            {
                var card = new Panel { Width = 300, Height = 180, BackColor = Color.White, BorderStyle = BorderStyle.FixedSingle, Margin = new Padding(8) };
                // show seller logo prominently, fall back to portfolio picture, then nothing
                string? imgPath = !string.IsNullOrEmpty(s.LogoPath) && File.Exists(s.LogoPath) ? s.LogoPath : (!string.IsNullOrEmpty(s.PortfolioPicPath) && File.Exists(s.PortfolioPicPath) ? s.PortfolioPicPath : null);
                if (!string.IsNullOrEmpty(imgPath))
                {
                    var thumb = LoadThumbnail(imgPath, 90, 90);
                    if (thumb != null)
                    {
                        var pic = new PictureBox { Left = 200, Top = 10, Width = 90, Height = 90, SizeMode = PictureBoxSizeMode.Zoom, Image = thumb, BorderStyle = BorderStyle.FixedSingle };
                        card.Controls.Add(pic);
                    }
                }
                var name = new Label { Text = s.CompanyName, Left = 10, Top = 10, Width = 180, Font = new Font("Segoe UI", 10, FontStyle.Bold) };
                var desc = new Label { Text = s.ShortDescription ?? "", Left = 10, Top = 35, Width = 180, Height = 90 };
                var btn = new Button { Text = "Open", Left = 10, Top = 140, Width = 80 };
                btn.Click += (sender, e) => { _nav.Push(() => ShowServiceSellers(serviceId, serviceName)); ShowSellerPortfolio(s.Id, s.CompanyName); };
                card.Controls.Add(name); card.Controls.Add(desc); card.Controls.Add(btn);
                flow.Controls.Add(card);
            }
            panel.Controls.Add(flow);
            LoadView(panel);
        }

        // Seller portfolio viewer (read-only)
        private void ShowSellerPortfolio(int sellerId, string companyName)
        {
            var panel = new Panel { Dock = DockStyle.Fill, BackColor = _pnlMain.BackColor, AutoScroll = true };
            var back = CreateBackButton(); panel.Controls.Add(back);
            var title = new Label { Text = companyName + " - Portfolio", Left = 120, Top = 14, AutoSize = true, Font = new Font("Segoe UI", 12, FontStyle.Bold) };
            panel.Controls.Add(title);
            var y = 50;
            var portfolio = _portfolioService.Get(sellerId);
            var seller = _sellerRepo.GetSellerEntityById(sellerId);

            // Top details from seller_portfolio and sellers
            var details = new Panel { Left = 20, Top = y, Width = _pnlMain.Width - 40, Height = 300, BackColor = Color.White, BorderStyle = BorderStyle.FixedSingle };
            int left = 20;
            // Portfolio: Description
            var hdrDesc = new Label { Text = "Description", Left = left, Top = 10, AutoSize = true, Font = new Font("Segoe UI", 9, FontStyle.Bold) };
            var lblDesc = new Label { Text = portfolio?.Description ?? "", Left = left, Top = 30, Width = 520, Height = 90 };
            details.Controls.Add(hdrDesc); details.Controls.Add(lblDesc);
            // Portfolio: Skills
            var hdrSkills = new Label { Text = "Skills", Left = left, Top = 125, AutoSize = true, Font = new Font("Segoe UI", 9, FontStyle.Bold) };
            var lblSkills = new Label { Text = portfolio?.Skills ?? "", Left = left, Top = 145, Width = 520, Height = 40 };
            details.Controls.Add(hdrSkills); details.Controls.Add(lblSkills);
            // Portfolio: Price Range
            var hdrPrice = new Label { Text = "Price Range", Left = left, Top = 195, AutoSize = true, Font = new Font("Segoe UI", 9, FontStyle.Bold) };
            string priceText = string.Empty;
            if (portfolio != null && (portfolio.PriceRangeMin.HasValue || portfolio.PriceRangeMax.HasValue))
            {
                var min = portfolio.PriceRangeMin?.ToString("0.##") ?? "-";
                var max = portfolio.PriceRangeMax?.ToString("0.##") ?? "-";
                priceText = $"{min} - {max}";
            }
            var lblPrice = new Label { Text = priceText, Left = left + 100, Top = 195, AutoSize = true };
            details.Controls.Add(hdrPrice); details.Controls.Add(lblPrice);
            // Portfolio: Profile Picture
            var hdrPic = new Label { Text = "Profile Picture", Left = 560, Top = 10, AutoSize = true, Font = new Font("Segoe UI", 9, FontStyle.Bold) };
            details.Controls.Add(hdrPic);
            if (!string.IsNullOrEmpty(portfolio?.ProfilePicPath) && File.Exists(portfolio.ProfilePicPath))
            {
                var thumb = LoadThumbnail(portfolio.ProfilePicPath, 120, 120);
                if (thumb != null)
                {
                    var pic = new PictureBox { Left = 560, Top = 30, Width = 120, Height = 120, SizeMode = PictureBoxSizeMode.Zoom, Image = thumb, BorderStyle = BorderStyle.FixedSingle };
                    details.Controls.Add(pic);
                }
            }
            // Seller details (from sellers)
            if (seller != null)
            {
                int sTop = 230;
                details.Controls.Add(new Label { Text = "Company", Left = left, Top = sTop, AutoSize = true, Font = new Font("Segoe UI", 9, FontStyle.Bold) });
                details.Controls.Add(new Label { Text = seller.CompanyName, Left = left + 100, Top = sTop, AutoSize = true });
                details.Controls.Add(new Label { Text = "Email", Left = 350, Top = sTop, AutoSize = true, Font = new Font("Segoe UI", 9, FontStyle.Bold) });
                details.Controls.Add(new Label { Text = seller.Email, Left = 400, Top = sTop, AutoSize = true });
                details.Controls.Add(new Label { Text = "Phone", Left = left, Top = sTop + 25, AutoSize = true, Font = new Font("Segoe UI", 9, FontStyle.Bold) });
                details.Controls.Add(new Label { Text = seller.Phone ?? "", Left = left + 100, Top = sTop + 25, AutoSize = true });
                details.Controls.Add(new Label { Text = "Address", Left = 350, Top = sTop + 25, AutoSize = true, Font = new Font("Segoe UI", 9, FontStyle.Bold) });
                details.Controls.Add(new Label { Text = seller.CompanyAddress ?? "", Left = 410, Top = sTop + 25, AutoSize = true, Width = 300 });
            }
            panel.Controls.Add(details);
            y += details.Height + 10;

            // Request Order (use logged-in user context, no input)
            var btnRequest = new Button { Text = "Request Order", Left = 20, Top = y, Width = 140, Height = 30 };
            btnRequest.Click += (s, e) =>
            {
                // TODO: Create order request record linking user _profile.Id to sellerId
                MessageBox.Show($"Order request sent by '{_profile.Name}' to '{companyName}'.", "Request Sent", MessageBoxButtons.OK, MessageBoxIcon.Information);
            };
            panel.Controls.Add(btnRequest);
            y += 50;

            // Past projects
            var projectsTitle = new Label { Text = "Past Projects", Left = 20, Top = y, AutoSize = true, Font = new Font("Segoe UI", 12, FontStyle.Bold) };
            panel.Controls.Add(projectsTitle); y += 30;
            var flow = new FlowLayoutPanel { Left = 20, Top = y, Width = _pnlMain.Width - 40, Height = 260, AutoScroll = true, WrapContents = true, FlowDirection = FlowDirection.LeftToRight };
            foreach (var p in _portfolioService.ListProjects(sellerId))
            {
                var card = new Panel { Width = 260, Height = 160, BackColor = Color.White, BorderStyle = BorderStyle.FixedSingle, Margin = new Padding(8) };
                var name = new Label { Text = p.Title, Left = 10, Top = 10, Width = 150, Font = new Font("Segoe UI", 9, FontStyle.Bold) };
                var desc = new Label { Text = p.Description ?? "", Left = 10, Top = 35, Width = 150, Height = 70 };
                if (!string.IsNullOrEmpty(p.ImagePath) && File.Exists(p.ImagePath))
                {
                    var thumb = LoadThumbnail(p.ImagePath, 80, 80);
                    if (thumb != null)
                    {
                        var pic = new PictureBox { Left = 170, Top = 10, Width = 80, Height = 80, SizeMode = PictureBoxSizeMode.Zoom, Image = thumb, BorderStyle = BorderStyle.FixedSingle };
                        card.Controls.Add(pic);
                    }
                }
                card.Controls.Add(name); card.Controls.Add(desc);
                flow.Controls.Add(card);
            }
            panel.Controls.Add(flow);

            LoadView(panel);
        }

        private void LoadView(Control view)
        {
            // Dispose previous view safely
            if (_currentView != null)
            {
                _pnlMain.Controls.Remove(_currentView);
                _currentView.Dispose();
                _currentView = null;
            }

            _currentView = view;
            _pnlMain.Controls.Clear();
            _pnlMain.Controls.Add(view);
        }
    }
}