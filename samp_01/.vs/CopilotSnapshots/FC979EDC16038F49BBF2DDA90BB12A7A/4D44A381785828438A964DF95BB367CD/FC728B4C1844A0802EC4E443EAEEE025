using System;
using System.Collections.Generic;
using System.Drawing;
using System.IO;
using System.Windows.Forms;
using samp_01.Domain.DTO;
using samp_01.Data.Repositories;
using samp_01.Services.ServiceProvider;

namespace samp_01.Forms.User
{
    public class UserServicesForm : Form
    {
        private readonly UserProfileDTO _user;
        private readonly IServiceRepository _serviceRepo = new AdoServiceRepository(AppConfig.ConnectionString);
        private readonly ISellerRepository _sellerRepo = new AdoSellerRepository(AppConfig.ConnectionString);
        private readonly PortfolioService _portfolioService = new PortfolioService();
        private readonly Stack<Action> _nav = new Stack<Action>();
        private Panel _host = null!;

        private static readonly Color TitleColor = Color.FromArgb(45, 45, 48);
        private static readonly Color TextColor = Color.FromArgb(80, 80, 80);
        private static readonly Color CardBg = Color.White;
        private static readonly Font TitleFont = new Font("Segoe UI", 18, FontStyle.Bold);
        private static readonly Font CardTitleFont = new Font("Segoe UI", 12, FontStyle.Bold);
        private static readonly Font BodyFont = new Font("Segoe UI", 9);

        public UserServicesForm(UserProfileDTO user)
        {
            _user = user;
            Text = "Services";
            ClientSize = new Size(1000, 700);
            StartPosition = FormStartPosition.CenterScreen;
            BackColor = Color.FromArgb(248, 249, 250);
            Font = BodyFont;

            _host = new Panel { Dock = DockStyle.Fill, BackColor = BackColor, AutoScroll = true };
            Controls.Add(_host);

            ShowServices();
        }

        private static Image? LoadThumbnail(string path, int w, int h)
        {
            try
            {
                using var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read);
                using var img = Image.FromStream(fs, false, false);
                var bmp = new Bitmap(w, h);
                using var g = Graphics.FromImage(bmp);
                g.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.HighQualityBicubic;
                g.DrawImage(img, new Rectangle(0, 0, w, h));
                return bmp;
            }
            catch { return null; }
        }

        private Button CreateBackButton()
        {
            var btn = new Button
            {
                Text = "← Back",
                Left = 20,
                Top = 9,
                Width = 100,
                Height = 32,
                BackColor = Color.Transparent,
                FlatStyle = FlatStyle.Flat,
                Font = BodyFont
            };
            btn.FlatAppearance.BorderColor = Color.FromArgb(200, 200, 200);
            btn.FlatAppearance.BorderSize = 1;
            btn.Click += (s, e) => { if (_nav.Count > 0) { var a = _nav.Pop(); a(); } };
            return btn;
        }

        private Panel CreatePage(string title, bool showBack, out Panel content)
        {
            var root = new Panel { Dock = DockStyle.Fill, BackColor = _host.BackColor, AutoScroll = true, Padding = new Padding(20) };

            // Add content first, then header, so header stays at the very top when Dock=Top
            content = new Panel { Dock = DockStyle.Top, AutoSize = true, BackColor = Color.Transparent };
            root.Controls.Add(content);

            var header = new Panel { Dock = DockStyle.Top, Height = 50, BackColor = Color.Transparent };
            if (showBack)
            {
                header.Controls.Add(CreateBackButton());
            }
            var lbl = new Label { Text = title, Left = showBack ? 140 : 0, Top = 10, AutoSize = true, Font = TitleFont, ForeColor = TitleColor };
            header.Controls.Add(lbl);
            root.Controls.Add(header);

            return root;
        }

        private void LoadView(Control view)
        {
            _host.Controls.Clear();
            _host.Controls.Add(view);
        }

        private void ShowServices()
        {
            var page = CreatePage("Available Services", false, out var body);

            var flow = new FlowLayoutPanel
            {
                Dock = DockStyle.Top,
                AutoSize = true,
                WrapContents = true,
                FlowDirection = FlowDirection.LeftToRight,
                BackColor = Color.Transparent
            };

            foreach (var svc in _serviceRepo.GetAll())
            {
                var card = new Panel { Width = 280, Height = 120, BackColor = CardBg, BorderStyle = BorderStyle.FixedSingle, Margin = new Padding(10), Padding = new Padding(15) };
                var name = new Label { Text = svc.Name, Left = 0, Top = 0, Width = 250, Font = CardTitleFont, ForeColor = TitleColor };
                var btn = new Button { Text = "View Providers", Left = 0, Top = 70, Width = 140, Height = 32, BackColor = Color.FromArgb(10, 132, 255), ForeColor = Color.White, FlatStyle = FlatStyle.Flat, Font = BodyFont };
                btn.FlatAppearance.BorderSize = 0;
                btn.Click += (s, e) => { _nav.Push(ShowServices); ShowServiceSellers(svc.Id, svc.Name); };
                card.Controls.Add(name);
                card.Controls.Add(btn);
                flow.Controls.Add(card);
            }

            body.Controls.Add(flow);
            LoadView(page);
        }

        private void ShowServiceSellers(int serviceId, string serviceName)
        {
            var page = CreatePage(serviceName + " - Service Providers", true, out var body);

            var flow = new FlowLayoutPanel
            {
                Dock = DockStyle.Top,
                AutoSize = true,
                WrapContents = true,
                FlowDirection = FlowDirection.LeftToRight,
                BackColor = Color.Transparent
            };

            var sellers = _sellerRepo.GetSellersByService(serviceId);
            foreach (var s in sellers)
            {
                var card = new Panel { Width = 320, Height = 200, BackColor = CardBg, BorderStyle = BorderStyle.FixedSingle, Margin = new Padding(10), Padding = new Padding(15) };

                string? imgPath = !string.IsNullOrEmpty(s.LogoPath) && File.Exists(s.LogoPath)
                    ? s.LogoPath
                    : (!string.IsNullOrEmpty(s.PortfolioPicPath) && File.Exists(s.PortfolioPicPath) ? s.PortfolioPicPath : null);

                if (!string.IsNullOrEmpty(imgPath))
                {
                    var thumb = LoadThumbnail(imgPath, 80, 80);
                    if (thumb != null)
                    {
                        var pic = new PictureBox { Left = 220, Top = 15, Width = 80, Height = 80, SizeMode = PictureBoxSizeMode.Zoom, Image = thumb, BorderStyle = BorderStyle.FixedSingle };
                        card.Controls.Add(pic);
                    }
                }

                var name = new Label { Text = s.CompanyName, Left = 0, Top = 0, Width = 200, Font = CardTitleFont, ForeColor = TitleColor };
                var desc = new Label { Text = s.ShortDescription ?? "No description available", Left = 0, Top = 30, Width = 200, Height = 60, ForeColor = TextColor };
                var btn = new Button { Text = "View Portfolio", Left = 0, Top = 150, Width = 140, Height = 32, BackColor = Color.FromArgb(10, 132, 255), ForeColor = Color.White, FlatStyle = FlatStyle.Flat, Font = BodyFont };
                btn.FlatAppearance.BorderSize = 0;
                btn.Click += (sender, e) => { _nav.Push(() => ShowServiceSellers(serviceId, serviceName)); ShowSellerPortfolio(s.Id, s.CompanyName); };
                card.Controls.Add(name);
                card.Controls.Add(desc);
                card.Controls.Add(btn);
                flow.Controls.Add(card);
            }

            body.Controls.Add(flow);
            LoadView(page);
        }

        private void ShowSellerPortfolio(int sellerId, string companyName)
        {
            var page = CreatePage(companyName + " - Portfolio", true, out var body);

            // Build a vertical stack to keep order stable: Details -> Request -> Projects
            var stack = new FlowLayoutPanel
            {
                Dock = DockStyle.Top,
                AutoSize = true,
                FlowDirection = FlowDirection.TopDown,
                WrapContents = false,
                BackColor = Color.Transparent
            };

            var portfolio = _portfolioService.Get(sellerId);
            var seller = _sellerRepo.GetSellerEntityById(sellerId);

            // Details card
            var details = new Panel { Width = 920, Height = 320, BackColor = CardBg, BorderStyle = BorderStyle.FixedSingle, Padding = new Padding(20) };
            int left = 0;
            var hdrDesc = new Label { Text = "Description", Left = left, Top = 0, AutoSize = true, Font = CardTitleFont, ForeColor = TitleColor };
            var lblDesc = new Label { Text = portfolio?.Description ?? "No description available", Left = left, Top = 25, Width = 500, Height = 60, ForeColor = TextColor };
            var hdrSkills = new Label { Text = "Skills & Expertise", Left = left, Top = 100, AutoSize = true, Font = CardTitleFont, ForeColor = TitleColor };
            var lblSkills = new Label { Text = portfolio?.Skills ?? "No skills listed", Left = left, Top = 125, Width = 500, Height = 40, ForeColor = TextColor };
            var hdrPrice = new Label { Text = "Price Range", Left = left, Top = 180, AutoSize = true, Font = CardTitleFont, ForeColor = TitleColor };
            string priceText = "Not specified";
            if (portfolio != null && (portfolio.PriceRangeMin.HasValue || portfolio.PriceRangeMax.HasValue))
            {
                var min = portfolio.PriceRangeMin?.ToString("0.##") ?? "-";
                var max = portfolio.PriceRangeMax?.ToString("0.##") ?? "-";
                priceText = $"{min} - {max}";
            }
            var lblPrice = new Label { Text = priceText, Left = left + 120, Top = 180, AutoSize = true, ForeColor = TextColor };
            var hdrPic = new Label { Text = "Profile Picture", Left = 600, Top = 0, AutoSize = true, Font = CardTitleFont, ForeColor = TitleColor };
            details.Controls.AddRange(new Control[] { hdrDesc, lblDesc, hdrSkills, lblSkills, hdrPrice, lblPrice, hdrPic });
            if (!string.IsNullOrEmpty(portfolio?.ProfilePicPath) && File.Exists(portfolio.ProfilePicPath))
            {
                var thumb = LoadThumbnail(portfolio.ProfilePicPath, 120, 120);
                if (thumb != null)
                {
                    var pic = new PictureBox { Left = 600, Top = 25, Width = 120, Height = 120, SizeMode = PictureBoxSizeMode.Zoom, Image = thumb, BorderStyle = BorderStyle.FixedSingle };
                    details.Controls.Add(pic);
                }
            }
            if (seller != null)
            {
                int sTop = 230;
                details.Controls.Add(new Label { Text = "Company", Left = left, Top = sTop, AutoSize = true, Font = BodyFont, ForeColor = TitleColor });
                details.Controls.Add(new Label { Text = seller.CompanyName, Left = left + 120, Top = sTop, AutoSize = true, ForeColor = TextColor });
                details.Controls.Add(new Label { Text = "Email", Left = 380, Top = sTop, AutoSize = true, Font = BodyFont, ForeColor = TitleColor });
                details.Controls.Add(new Label { Text = seller.Email, Left = 430, Top = sTop, AutoSize = true, ForeColor = TextColor });
                details.Controls.Add(new Label { Text = "Phone", Left = left, Top = sTop + 25, AutoSize = true, Font = BodyFont, ForeColor = TitleColor });
                details.Controls.Add(new Label { Text = seller.Phone ?? "Not provided", Left = left + 120, Top = sTop + 25, AutoSize = true, ForeColor = TextColor });
                details.Controls.Add(new Label { Text = "Address", Left = 380, Top = sTop + 25, AutoSize = true, Font = BodyFont, ForeColor = TitleColor });
                details.Controls.Add(new Label { Text = seller.CompanyAddress ?? "Not provided", Left = 450, Top = sTop + 25, AutoSize = true, Width = 280, ForeColor = TextColor });
            }
            stack.Controls.Add(details);

            // Request button (opens dialog)
            var btnRequest = new Button { Text = "Request Service", Width = 160, Height = 40, BackColor = Color.FromArgb(10, 132, 255), ForeColor = Color.White, FlatStyle = FlatStyle.Flat, Font = new Font("Segoe UI", 10, FontStyle.Bold), Margin = new Padding(20, 10, 0, 10) };
            btnRequest.FlatAppearance.BorderSize = 0;
            btnRequest.Click += (s, e) =>
            {
                using var dlg = new RequestOrderDialog(companyName);
                if (dlg.ShowDialog(this) == DialogResult.OK)
                {
                    // TODO: persist order request with _user.Id, sellerId, dlg.Description
                    MessageBox.Show("Your request has been submitted.", "Request Sent", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
            };
            stack.Controls.Add(btnRequest);

            // Projects title
            var projectsTitle = new Label { Text = "Past Projects", AutoSize = true, Font = TitleFont, ForeColor = TitleColor, Margin = new Padding(20, 10, 0, 0) };
            stack.Controls.Add(projectsTitle);

            // Projects flow
            var flow = new FlowLayoutPanel { AutoSize = true, WrapContents = true, FlowDirection = FlowDirection.LeftToRight, BackColor = Color.Transparent, Margin = new Padding(20, 10, 20, 20) };
            foreach (var p in _portfolioService.ListProjects(sellerId))
            {
                var card = new Panel { Width = 280, Height = 180, BackColor = CardBg, BorderStyle = BorderStyle.FixedSingle, Margin = new Padding(10), Padding = new Padding(15) };
                var name = new Label { Text = p.Title, Left = 0, Top = 0, Width = 150, Font = CardTitleFont, ForeColor = TitleColor };
                var desc = new Label { Text = p.Description ?? "No description available", Left = 0, Top = 25, Width = 150, Height = 70, ForeColor = TextColor };
                if (!string.IsNullOrEmpty(p.ImagePath) && File.Exists(p.ImagePath))
                {
                    var thumb = LoadThumbnail(p.ImagePath, 80, 80);
                    if (thumb != null)
                    {
                        var pic = new PictureBox { Left = 170, Top = 10, Width = 80, Height = 80, SizeMode = PictureBoxSizeMode.Zoom, Image = thumb, BorderStyle = BorderStyle.FixedSingle };
                        card.Controls.Add(pic);
                    }
                }
                card.Controls.Add(name);
                card.Controls.Add(desc);
                flow.Controls.Add(card);
            }
            stack.Controls.Add(flow);

            body.Controls.Add(stack);
            LoadView(page);
        }
    }

    // Simple dialog to enter request description
    internal class RequestOrderDialog : Form
    {
        private TextBox _txt;
        public string? Description => string.IsNullOrWhiteSpace(_txt.Text) ? null : _txt.Text.Trim();
        public RequestOrderDialog(string company)
        {
            Text = $"Request Service - {company}";
            ClientSize = new Size(480, 240);
            StartPosition = FormStartPosition.CenterParent;
            Font = new Font("Segoe UI", 9);
            var lbl = new Label { Text = "Describe your request", Left = 12, Top = 16, AutoSize = true };
            _txt = new TextBox { Left = 12, Top = 40, Width = 456, Height = 120, Multiline = true, ScrollBars = ScrollBars.Vertical };
            var ok = new Button { Text = "Send", Left = 308, Top = 180, Width = 80, DialogResult = DialogResult.OK };
            var cancel = new Button { Text = "Cancel", Left = 396, Top = 180, Width = 80, DialogResult = DialogResult.Cancel };
            Controls.AddRange(new Control[] { lbl, _txt, ok, cancel });
            AcceptButton = ok; CancelButton = cancel;
        }
    }
}